    "Some backup files are still in iCloud. Download them in the Files app, then try again.": {
      "comment": "ImportExportError (BIG-795)",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Backup-Dateien befinden sich noch in iCloud. Laden Sie sie in der Dateien-App herunter und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos archivos de la copia de seguridad siguen en iCloud. Descárgalos en la app Archivos y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains fichiers de sauvegarde sont encore dans iCloud. Téléchargez-les dans l'app Fichiers, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のバックアップファイルはまだiCloudにあります。ファイルAppでダウンロードしてから、もう一度お試しください。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ข้อมูลสำรองบางไฟล์ยังอยู่ใน iCloud โปรดดาวน์โหลดในแอปไฟล์แล้วลองอีกครั้ง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分备份文件仍在 iCloud 中。请在“文件”App 中下载后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
