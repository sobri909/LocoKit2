          }
        }
      }
    },
    "The backup folder has data but no manifest, so nothing was overwritten.": {
      "comment": "ImportExportError (BIG-795)",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Backup-Ordner enthält Daten, aber kein Manifest, daher wurde nichts überschrieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta de copia de seguridad tiene datos pero no un manifiesto, así que no se sobrescribió nada."
          }
        },
        "fr": {
          "stringUnit": {
